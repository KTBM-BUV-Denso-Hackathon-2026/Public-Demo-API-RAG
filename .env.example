# =============================================================================
# rag_worker — mẫu cấu hình. Copy thành .env rồi sửa giá trị thật:
#   cp .env.example .env
# =============================================================================

# --- Database (CHUNG với denso_backend và llm_api) -------------------------
# GIÁ TRỊ NÀY PHẢI GIỐNG HỐT DATABASE_URL trong denso_backend/.env và
# llm_api/.env. Nếu lệch, worker sẽ ghi chunk vào một DB mà không ai đọc
# (hiện tượng: upload báo "done" nhưng hỏi đáp không ra context nào).
# GIÁ TRỊ MẪU khớp docker-compose.yml (database=denso, user=denso, pass=denso).
DATABASE_URL=postgresql://denso:denso@localhost:5432/denso
DB_POOL_MIN=1
DB_POOL_MAX=5
# Số lần thử lại khi connection pooler của cloud Postgres (Neon/Supabase —
# hostname có chữ "-pooler") đã chủ động đóng kết nối rảnh trong lúc ta vẫn
# giữ nó trong pool. Worker chạy nền lâu nên dễ dính lỗi này. Đặt 1 nếu DB
# local (docker compose) không qua pooler.
DB_PREPING_ATTEMPTS=2

# --- Embedding -------------------------------------------------------------
# PHẢI khớp EMBEDDING_MODEL/EMBEDDING_DIM của llm_api và cột `vector` của DB.
EMBEDDING_MODEL=bkai-foundation-models/vietnamese-bi-encoder
EMBEDDING_DIM=768
STRICT_EMBEDDING_DIM=true
EMBEDDING_BATCH_SIZE=32

# --- Chia nhỏ văn bản ------------------------------------------------------
CHUNK_SIZE=1000
MIN_CHUNK_SIZE=80

# --- Tải file --------------------------------------------------------------
DOWNLOAD_TIMEOUT=60
# Thư mục media của denso_backend — dùng khi `file_url` là đường dẫn nội bộ
# (ví dụ /media/rag_files/abc.md).
# PHẢI khớp MEDIA_ROOT của denso_backend (mặc định: <workspace>/denso_backend/media).
# Đường dẫn tương đối được tính theo thư mục chứa file .env này.
MEDIA_ROOT=../denso_backend/media
# Tiền tố URL media của Django (phải khớp MEDIA_URL của denso_backend).
MEDIA_URL=/media/

# --- Xác thực nội bộ -------------------------------------------------------
# Shared-secret mà denso_backend gửi kèm header `X-Internal-Token` cho
# POST /ingest. PHẢI BẰNG `RAG_WORKER_TOKEN` trong denso_backend/.env.
# Rỗng = tắt auth (chỉ dành cho localhost). Production BẮT BUỘC đặt.
# Sinh: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_TOKEN=

# --- Celery (chỉ cần khi denso_backend đặt RAG_INGEST_MODE=celery) ---------
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=
CELERY_TASK_QUEUE=rag

# --- HTTP API --------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8200
LOG_LEVEL=INFO
